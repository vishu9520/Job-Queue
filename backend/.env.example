# PostgreSQL connection string from Neon (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Port (Railway sets this automatically, keep 3001 for local dev)
PORT=3001

# Your Vercel frontend URL (set this on Railway after deploying frontend)
FRONTEND_URL=https://your-app.vercel.app

NODE_ENV=production
